# Public Supabase configuration (publishable / anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Server-only. NEVER expose as NEXT_PUBLIC_*.
# Required for Superadmin account creation/disable operations and approved admin scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Institution
NEXT_PUBLIC_APP_URL=http://localhost:3000
INSTITUTION_TIMEZONE=America/Mexico_City
DOCUMENT_VERIFICATION_SECRET=replace-with-a-long-random-secret

# Optional e2e test accounts. Never commit real credentials.
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=
E2E_CONTROL_EMAIL=
E2E_CONTROL_PASSWORD=
E2E_SUPERADMIN_EMAIL=
E2E_SUPERADMIN_PASSWORD=

# Optional local demo provisioning. Keep blank to generate strong one-time passwords.
ALLOW_DEMO_USERS=
DEMO_STUDENT_PASSWORD=
DEMO_TEACHER_PASSWORD=
DEMO_CONTROL_PASSWORD=
DEMO_SUPERADMIN_PASSWORD=

# One-time first SUPERADMIN bootstrap. Use only before any SUPERADMIN exists.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_NAME=
# Optional; leave blank for a cryptographically generated one-time password.
BOOTSTRAP_SUPERADMIN_PASSWORD=
